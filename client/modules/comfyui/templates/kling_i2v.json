{
    "id": "kling_i2v",
    "name": "Kling V3 图生视频",
    "description": "Kling V3 云端图生视频（需要 ComfyUI 账户积分）",
    "category": "video",
    "mode": "img2vid",
    "cloud": true,
    "parameters": [
        { "key": "start_frame", "label": "首帧图片", "type": "image", "required": true },
        { "key": "prompt", "label": "提示词", "type": "textarea" },
        { "key": "negative_prompt", "label": "负面提示词", "type": "textarea" },
        { "key": "model", "label": "模型", "type": "select", "choices": ["kling-v3"], "default": "kling-v3" },
        { "key": "resolution", "label": "分辨率", "type": "select", "choices": ["4k", "1080p", "720p"], "default": "1080p" },
        { "key": "aspect_ratio", "label": "宽高比", "type": "select", "choices": ["16:9", "9:16", "1:1"], "default": "16:9" },
        { "key": "duration", "label": "时长(秒)", "type": "number", "default": 5, "min": 3, "max": 15, "step": 1 },
        { "key": "generate_audio", "label": "生成音频", "type": "boolean", "default": true },
        { "key": "seed", "label": "种子", "type": "number", "default": 0, "min": 0, "max": 2147483647 }
    ],
    "workflow": {
        "1": {
            "class_type": "KlingVideoNode",
            "inputs": {
                "multi_shot": "disabled",
                "multi_shot.prompt": "{{prompt}}",
                "multi_shot.negative_prompt": "{{negative_prompt}}",
                "multi_shot.duration": "{{duration}}",
                "start_frame": ["start_frame_loader", 0],
                "model": "{{model}}",
                "model.resolution": "{{resolution}}",
                "model.aspect_ratio": "{{aspect_ratio}}",
                "generate_audio": "{{generate_audio}}",
                "seed": "{{seed}}"
            }
        },
        "2": {
            "class_type": "SaveVideo",
            "inputs": {
                "video": ["1", 0],
                "filename_prefix": "video/ComfyUI",
                "format": "auto",
                "codec": "auto"
            }
        },
        "start_frame_loader": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{start_frame}}"
            }
        }
    }
}
