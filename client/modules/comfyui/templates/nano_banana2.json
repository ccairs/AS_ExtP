            }
        },
        "ref_image_loader_7": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_7}}"
            }
        },
        "ref_image_loader_8": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_8}}"
            }
        },
        "ref_image_loader_9": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_9}}"
            }
        },
        "ref_image_loader_10": {
