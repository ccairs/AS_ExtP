{
    "id": "happyhorse_r2v",
    "name": "HappyHorse 参考图生视频",
    "description": "HappyHorse 参考图视频生成，支持多张参考图（角色/物体），至少 1 张（需要 ComfyUI 账户积分）",
    "category": "video",
    "mode": "img2vid",
    "cloud": true,
    "parameters": [
        { "key": "reference_image", "label": "参考图片", "type": "image", "multiple": true, "maxCount": 9 },
        { "key": "prompt", "label": "提示词", "type": "textarea", "required": true },
        { "key": "resolution", "label": "分辨率", "type": "select", "choices": ["720P", "1080P"], "default": "720P" },
        { "key": "ratio", "label": "宽高比", "type": "select", "choices": ["16:9", "9:16", "1:1", "4:3", "3:4"], "default": "16:9" },
        { "key": "duration", "label": "时长(秒)", "type": "number", "default": 5, "min": 3, "max": 15, "step": 1 },
        { "key": "seed", "label": "种子", "type": "number", "default": 0, "min": 0, "max": 2147483647 },
        { "key": "watermark", "label": "水印", "type": "boolean", "default": false }
    ],
    "workflow": {
        "1": {
            "class_type": "HappyHorseReferenceVideoApi",
            "inputs": {
                "model": "happyhorse-1.0-r2v",
                "model.prompt": "{{prompt}}",
                "model.resolution": "{{resolution}}",
                "model.ratio": "{{ratio}}",
                "model.duration": "{{duration}}",
                "model.reference_images.image1": ["ref_image_loader_1", 0],
                "model.reference_images.image2": ["ref_image_loader_2", 0],
                "model.reference_images.image3": ["ref_image_loader_3", 0],
                "model.reference_images.image4": ["ref_image_loader_4", 0],
                "model.reference_images.image5": ["ref_image_loader_5", 0],
                "model.reference_images.image6": ["ref_image_loader_6", 0],
                "model.reference_images.image7": ["ref_image_loader_7", 0],
                "model.reference_images.image8": ["ref_image_loader_8", 0],
                "model.reference_images.image9": ["ref_image_loader_9", 0],
                "seed": "{{seed}}",
                "watermark": "{{watermark}}"
            }
        },
        "2": {
            "class_type": "SaveVideo",
            "inputs": {
                "video": ["1", 0],
                "filename_prefix": "video/ComfyUI",
                "format": "auto",
                "codec": "auto"
            }
        },
        "ref_image_loader_1": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_1}}"
            }
        },
        "ref_image_loader_2": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_2}}"
            }
        },
        "ref_image_loader_3": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_3}}"
            }
        },
        "ref_image_loader_4": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_4}}"
            }
        },
        "ref_image_loader_5": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_5}}"
            }
        },
        "ref_image_loader_6": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_6}}"
            }
        },
        "ref_image_loader_7": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_7}}"
            }
        },
        "ref_image_loader_8": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_8}}"
            }
        },
        "ref_image_loader_9": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_9}}"
            }
        }
    }
}
