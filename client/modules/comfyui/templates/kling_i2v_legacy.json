{
    "id": "kling_i2v_legacy",
    "name": "Kling 图生视频(旧版)",
    "description": "Kling 旧版图生视频（kling-v2-5-turbo / v2-master / v1 系列等，需要 ComfyUI 账户积分）",
    "category": "video",
    "mode": "img2vid",
    "cloud": true,
    "parameters": [
        { "key": "start_frame", "label": "首帧图片", "type": "image", "required": true },
        { "key": "prompt", "label": "提示词", "type": "textarea" },
        { "key": "negative_prompt", "label": "负面提示词", "type": "textarea" },
        { "key": "model_name", "label": "模型", "type": "select", "choices": ["kling-v2-5-turbo", "kling-v2-master", "kling-v2-1-master", "kling-v2-1", "kling-v1-6", "kling-v1-5", "kling-v1"], "default": "kling-v2-5-turbo" },
        { "key": "cfg_scale", "label": "提示词相关性", "type": "number", "default": 0.8, "min": 0, "max": 1, "step": 0.1 },
        { "key": "mode", "label": "模式", "type": "select", "choices": ["std", "pro"], "default": "std" },
        { "key": "aspect_ratio", "label": "宽高比", "type": "select", "choices": ["16:9", "9:16", "1:1"], "default": "16:9" },
        { "key": "duration", "label": "时长(秒)", "type": "select", "choices": ["5", "10"], "default": "5" }
    ],
    "workflow": {
        "1": {
            "class_type": "KlingImage2VideoNode",
            "inputs": {
                "start_frame": ["start_frame_loader", 0],
                "prompt": "{{prompt}}",
                "negative_prompt": "{{negative_prompt}}",
                "model_name": "{{model_name}}",
                "cfg_scale": "{{cfg_scale}}",
                "mode": "{{mode}}",
                "aspect_ratio": "{{aspect_ratio}}",
                "duration": "{{duration}}"
            }
        },
        "2": {
            "class_type": "SaveVideo",
            "inputs": {
                "video": ["1", 0],
                "filename_prefix": "video/ComfyUI",
                "format": "auto",
                "codec": "auto"
            }
        },
        "start_frame_loader": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{start_frame}}"
            }
        }
    }
}
