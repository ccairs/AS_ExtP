{
    "id": "seedance2_ref",
    "name": "Seedance 2.0 全能参考",
    "description": "Seedance 2.0 云端全能参考视频生成，支持图片/视频/音频参考（需要 ComfyUI 账户积分）",
    "category": "video",
    "mode": "txt2vid",
    "cloud": true,
    "parameters": [
        { "key": "prompt", "label": "提示词", "type": "textarea", "required": true },
        { "key": "reference_image", "label": "参考图片", "type": "image", "multiple": true, "maxCount": 9 },
        { "key": "reference_video", "label": "参考视频(可选)", "type": "video", "multiple": true, "maxCount": 3 },
        { "key": "model", "label": "模型", "type": "select", "choices": ["Seedance 2.0", "Seedance 2.0 Fast"], "default": "Seedance 2.0" },
        { "key": "resolution", "label": "分辨率", "type": "select", "choices": ["480p", "720p", "1080p"], "default": "720p" },
        { "key": "ratio", "label": "宽高比", "type": "select", "choices": ["adaptive", "16:9", "4:3", "1:1", "3:4", "9:16", "21:9"], "default": "adaptive" },
        { "key": "duration", "label": "时长(秒)", "type": "number", "default": 7, "min": 4, "max": 15, "step": 1 },
        { "key": "generate_audio", "label": "生成音频", "type": "boolean", "default": true },
        { "key": "seed", "label": "种子", "type": "number", "default": 0, "min": 0, "max": 2147483647 },
        { "key": "watermark", "label": "水印", "type": "boolean", "default": false },
        { "key": "auto_downscale", "label": "自动缩小适配", "type": "boolean", "default": true },
        { "key": "auto_upscale", "label": "自动放大增强", "type": "boolean", "default": false }
    ],
    "workflow": {
        "1": {
            "class_type": "ByteDance2ReferenceNode",
            "inputs": {
                "model": "{{model}}",
                "model.prompt": "{{prompt}}",
                "model.resolution": "{{resolution}}",
                "model.ratio": "{{ratio}}",
                "model.duration": "{{duration}}",
                "model.generate_audio": "{{generate_audio}}",
                "model.reference_images.image_1": ["ref_image_loader_1", 0],
                "model.reference_images.image_2": ["ref_image_loader_2", 0],
                "model.reference_images.image_3": ["ref_image_loader_3", 0],
                "model.reference_images.image_4": ["ref_image_loader_4", 0],
                "model.reference_images.image_5": ["ref_image_loader_5", 0],
                "model.reference_images.image_6": ["ref_image_loader_6", 0],
                "model.reference_images.image_7": ["ref_image_loader_7", 0],
                "model.reference_images.image_8": ["ref_image_loader_8", 0],
                "model.reference_images.image_9": ["ref_image_loader_9", 0],
                "model.reference_videos.video_1": ["ref_video_loader_1", 0],
                "model.reference_videos.video_2": ["ref_video_loader_2", 0],
                "model.reference_videos.video_3": ["ref_video_loader_3", 0],
                "model.auto_downscale": "{{auto_downscale}}",
                "model.auto_upscale": "{{auto_upscale}}",
                "seed": "{{seed}}",
                "watermark": "{{watermark}}"
            }
        },
        "2": {
            "class_type": "SaveVideo",
            "inputs": {
                "video": ["1", 0],
                "filename_prefix": "video/ComfyUI",
                "format": "auto",
                "codec": "auto"
            }
        },
        "ref_image_loader_1": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_1}}"
            }
        },
        "ref_image_loader_2": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_2}}"
            }
        },
        "ref_image_loader_3": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_3}}"
            }
        },
        "ref_image_loader_4": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_4}}"
            }
        },
        "ref_image_loader_5": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_5}}"
            }
        },
        "ref_image_loader_6": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_6}}"
            }
        },
        "ref_image_loader_7": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_7}}"
            }
        },
        "ref_image_loader_8": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_8}}"
            }
        },
        "ref_image_loader_9": {
            "class_type": "LoadImage",
            "inputs": {
                "image": "{{reference_image_9}}"
            }
        },
        "ref_video_loader_1": {
            "class_type": "LoadVideo",
            "inputs": {
                "file": "{{reference_video_1}}"
            }
        },
        "ref_video_loader_2": {
            "class_type": "LoadVideo",
            "inputs": {
                "file": "{{reference_video_2}}"
            }
        },
        "ref_video_loader_3": {
            "class_type": "LoadVideo",
            "inputs": {
                "file": "{{reference_video_3}}"
            }
        }
    }
}
