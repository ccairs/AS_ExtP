{
    "id": "txt2img",
    "name": "文生图",
    "description": "根据文字描述生成图片；本地 checkpoint 与 models/unet、models/diffusion_models 的受支持图像扩散模型（ANIMA / Qwen-Image / Krea 2）均可选（自动配置文本编码器、VAE 与推荐采样参数；Qwen-Image 族可加参考图做多图参考生成）",
    "category": "image",
    "mode": "txt2img",
    "modelSource": "mixed",
    "parameters": [
        { "key": "prompt", "label": "正向提示词", "type": "textarea", "required": true },
        { "key": "negative_prompt", "label": "负向提示词", "type": "textarea", "default": "" },
        { "key": "width", "label": "宽度", "type": "number", "default": 1024, "min": 256, "max": 4096, "step": 64 },
        { "key": "height", "label": "高度", "type": "number", "default": 1024, "min": 256, "max": 4096, "step": 64 },
        { "key": "batch_size", "label": "生成数量", "type": "number", "default": 1, "min": 1, "max": 16, "step": 1 },
        { "key": "steps", "label": "步数", "type": "number", "default": 20, "min": 1, "max": 150 },
        { "key": "cfg", "label": "CFG", "type": "number", "default": 7.0, "min": 1, "max": 30, "step": 0.5 },
        { "key": "sampler", "label": "采样器", "type": "select", "choices": ["euler", "er_sde", "euler_ancestral", "dpmpp_2m", "dpmpp_2m_sde", "dpmpp_sde", "dpmpp_2s_ancestral", "heun", "lms", "res_multistep", "ddim", "uni_pc"], "default": "euler" },
        { "key": "scheduler", "label": "调度器", "type": "select", "choices": ["normal", "simple", "karras", "exponential", "sgm_uniform", "ddim_uniform", "beta", "linear_quadratic"], "default": "normal" },
        { "key": "seed", "label": "种子", "type": "number", "default": -1, "min": -1, "max": 2147483647 },
        { "key": "reference_images", "label": "参考图（Qwen-Image 多图参考，可选）", "type": "image", "multiple": true, "maxCount": 8 }
    ],
    "workflow": {
        "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "v1-5-pruned-emaonly.safetensors" } },
        "2": { "class_type": "EmptyLatentImage", "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": 1 } },
        "3": { "class_type": "KSampler", "inputs": { "model": ["1", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["2", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "{{sampler}}", "scheduler": "{{scheduler}}", "denoise": 1.0 } },
        "4": { "class_type": "VAEDecode", "inputs": { "samples": ["3", 0], "vae": ["1", 2] } },
        "5": { "class_type": "SaveImage", "inputs": { "images": ["4", 0], "filename_prefix": "ComfyUI" } },
        "6": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{prompt}}", "clip": ["1", 1] } },
        "7": { "class_type": "CLIPTextEncode", "inputs": { "text": "{{negative_prompt}}", "clip": ["1", 1] } }
    }
}
